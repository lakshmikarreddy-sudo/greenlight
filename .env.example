# ==============================================================================
# Greenlight — Environment Configuration Template
# ==============================================================================

# Google Cloud / Vertex AI Settings
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=greenlight-ac-2026-lkr
GOOGLE_CLOUD_LOCATION=us-central1

# Parallel Search API (Generate from https://platform.parallel.ai)
# Optional: If omitted or empty, Greenlight operates with demo fallback evidence
PARALLEL_API_KEY=your_parallel_api_key_here

# Demo & Resilience Mode
# Set to true to enable high-fidelity local demonstration fixtures
DEMO_MODE=false
